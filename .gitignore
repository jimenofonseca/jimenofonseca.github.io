# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Project-local launch config (per-machine, not for deployment)
.claude/

# Local editing drafts (not for deployment — public pages in music/ and
# photography/ are authoritative)
private-src/

# Photography originals (kept on local machine only — too big for git)
assets/photography/_originals/

# Music assets (video now hosted on YouTube — local files not needed in repo)
assets/music/

# Superurbana promo video (48 MB). Only the retired _old/retired-pages/
# superurbana page ever referenced it, and that page is not published, so
# the file was a 48 MB download served to nobody. Kept locally, not in git.
assets/Superurbana_Promo.mp4

# macOS metadata — never useful in repo
.DS_Store
**/.DS_Store
